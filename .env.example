# Shared / local
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# Server (MongoDB Atlas). Empty URI = in-memory sample data.
MONGODB_URI=
MONGODB_DB=since_ai

# Client (Vite). Leave empty for same-origin + nginx/vite proxy.
VITE_API_BASE_URL=
VITE_PROXY_TARGET=http://localhost:8000
